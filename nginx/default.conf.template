server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Railway private-network DNS; resolved at request time so nginx
    # starts even if the backend is briefly unavailable.
    resolver [fd12::10] valid=10s ipv6=on;

    location /api/ {
        set $backend ${BACKEND_HOST};
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # React routing: unknown paths fall back to index.html
    location / {
        try_files $uri /index.html;
    }
}
